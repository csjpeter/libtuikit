# The ABI of libtuikit.so.0, checked by tests/unit/check_abi.sh (TUI-15).
#
# Within one SOVERSION a program built against any release runs on every
# later one, so no struct below changes its size or alignment and no
# function below disappears.  A change of either needs a new SOVERSION
# (and a new record, abi/libtuikit<N>.abi).  New structs and functions are
# added here as they are added to the headers.
#
# The ABI recorded here is that of 0.2.0 and later.  0.1.0 differs: its
# tui_dialog was 272 bytes (it grew by the checklist's `checked` pointer
# in 0.2.0, without a SOVERSION change).  Every package built against 0.1.0
# depends on libtuikit0 (= 0.1.0), so apt never pairs it with a later
# library; see TUI-15.
#
# size <struct> <bytes> <alignment>   symbol <exported function>
arch x86_64
size tui_actionmenu 328 8
size tui_buf 32 8
size tui_canvas 24 8
size tui_completion 16 8
size tui_decoder 312 8
size tui_dialog 280 8
size tui_event 56 8
size tui_field 152 8
size tui_fieldset 632 8
size tui_history 16 8
size tui_histview 1336 8
size tui_histview_row 80 8
size tui_keyentry 56 8
size tui_keyhelp 288 8
size tui_keytable 16 8
size tui_lineedit 104 8
size tui_listview 16 4
size tui_readline_opts 32 8
size tui_rect 16 4
